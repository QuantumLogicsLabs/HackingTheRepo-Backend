# MongoDB
MONGO_URI=mongodb://localhost:27017/repomind

# JWT (required in production)
JWT_SECRET=2771c6f41636e4e89af82115ec4c122776f65c3e75c7856070e365e77abefe89

# Encrypts stored GitHub/OpenAI secrets at rest (falls back to JWT_SECRET)
ENCRYPTION_KEY=your_32_plus_char_encryption_key_here

# Allowed frontend origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# RepoMind Bot Config
REPOMIND_GITHUB_TOKEN=ghp_your_bot_github_token_here
REPOMIND_GITHUB_USERNAME=your-bot-github-username

# RepoMind FastAPI backend
REPOMIND_API_URL=http://localhost:8000

# OpenAI (assistant fallback + optional RepoMind)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# GitHub OAuth (optional — enables Continue with GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

PORT=5000
NODE_ENV=development
